<section class="min-h-screen flex items-center justify-center bg-gray-50 px-4">
  <div class="w-full max-w-md bg-white rounded-xl shadow-md p-8 space-y-6">
    <h1 class="text-2xl font-semibold text-gray-800 text-center">Вход в админку</h1>

    <%= form_with model: resource,
                  as: resource_name,
                  url: session_path(resource_name),
                  local: true,
                  html: { class: "space-y-4" } do |f| %>
      <div>
        <%= f.label :email, "Email", class: "block text-sm font-medium text-gray-700" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "mt-1 w-full rounded-md border-gray-300 shadow-sm px-3 py-2 focus:ring-sky-500 focus:border-sky-500" %>
      </div>

      <div>
        <%= f.label :password, "Пароль", class: "block text-sm font-medium text-gray-700" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "mt-1 w-full rounded-md border-gray-300 shadow-sm px-3 py-2 focus:ring-sky-500 focus:border-sky-500" %>
      </div>

      <div class="flex items-center">
        <%= f.check_box :remember_me, class: "h-4 w-4 text-sky-600 border-gray-300 rounded" %>
        <%= f.label :remember_me, "Запомнить меня", class: "ml-2 block text-sm text-gray-700" %>
      </div>

      <%= f.submit "Войти", class: "w-full bg-sky-600 text-white py-2 rounded-md hover:bg-sky-500" %>
    <% end %>

    <div class="text-center text-sm text-gray-600">
      <%= link_to "Регистрация", new_registration_path(resource_name), class: "text-sky-600 hover:underline" %> |
      <%= link_to "На сайт", root_path, class: "text-gray-700 hover:underline" %>
    </div>
  </div>
</section>