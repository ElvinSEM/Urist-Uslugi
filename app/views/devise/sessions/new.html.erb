<%= form_for(resource, as: resource_name, url: session_path(resource_name),
             data: { turbo: false }) do |f| %>
  <div>
    <%= f.email_field :email, placeholder: "Email", value: "admin@example.com" %>
  </div>
  <div>
    <%= f.password_field :password, placeholder: "Password", value: "password123" %>
  </div>
  <%= f.submit "Sign in" %>
<% end %>

