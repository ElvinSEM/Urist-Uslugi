<section class="min-h-[calc(100vh-5rem)] bg-slate-950 px-4 py-10 sm:px-6 lg:px-8">
  <div class="mx-auto grid min-h-[calc(100vh-7rem)] max-w-6xl items-center lg:grid-cols-[0.95fr_1.05fr]">
    <div class="rounded-[2rem] border border-slate-800 bg-[radial-gradient(circle_at_top_right,_rgba(14,165,233,0.18),_transparent_30%),linear-gradient(180deg,_rgba(15,23,42,0.98),_rgba(2,6,23,0.98))] p-8 shadow-[0_30px_100px_rgba(2,6,23,0.45)] sm:p-10 lg:p-12">
      <p class="text-xs font-semibold uppercase tracking-[0.28em] text-sky-400">Account Access</p>
      <h1 class="mt-4 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
        <%= local_assigns[:action_title].presence || "Регистрация" %>
      </h1>
      <p class="mt-4 max-w-xl text-base leading-8 text-slate-300">
        Создайте учётную запись для доступа к платформе.
      </p>
    </div>

    <div class="-mt-6 lg:mt-0 lg:-mr-10">
      <div class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-[0_30px_80px_rgba(15,23,42,0.18)] sm:p-8"><section class="min-h-screen flex items-center justify-center bg-gray-50 px-4">
        <div class="w-full max-w-md bg-white rounded-xl shadow-md p-8 space-y-6">
          <h1 class="text-2xl font-semibold text-gray-800 text-center">Регистрация админа</h1>

          <%= form_with model: resource,
                        as: resource_name,
                        url: registration_path(resource_name),
                        local: true,
                        html: { class: "space-y-4" } do |f| %>
            <div>
              <%= f.label :email, "Email", class: "block text-sm font-medium text-gray-700" %>
              <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "mt-1 w-full rounded-md border-gray-300 shadow-sm px-3 py-2 focus:ring-sky-500 focus:border-sky-500" %>
            </div>

            <div>
              <%= f.label :password, "Пароль", class: "block text-sm font-medium text-gray-700" %>
              <%= f.password_field :password, autocomplete: "new-password", class: "mt-1 w-full rounded-md border-gray-300 shadow-sm px-3 py-2 focus:ring-sky-500 focus:border-sky-500" %>
            </div>

            <div>
              <%= f.label :password_confirmation, "Подтверждение пароля", class: "block text-sm font-medium text-gray-700" %>
              <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "mt-1 w-full rounded-md border-gray-300 shadow-sm px-3 py-2 focus:ring-sky-500 focus:border-sky-500" %>
            </div>

            <%= f.submit "Зарегистрироваться", class: "w-full bg-sky-600 text-white py-2 rounded-md hover:bg-sky-500" %>
          <% end %>

          <div class="text-center text-sm text-gray-600">
            <%= link_to "Вход", new_session_path(resource_name), class: "text-sky-600 hover:underline" %> |
            <%= link_to "На сайт", root_path, class: "text-gray-700 hover:underline" %>
          </div>
        </div>
      </section></div>
    </div>
  </div>
</section>
