<div class="mb-6 flex flex-col gap-4 rounded-[1.75rem] border border-slate-200 bg-white p-5 shadow-[0_18px_40px_rgba(15,23,42,0.06)] sm:p-6 lg:flex-row lg:items-end lg:justify-between">
  <div class="max-w-3xl space-y-2">
    <% if local_assigns[:eyebrow].present? %>
      <p class="text-xs font-semibold uppercase tracking-[0.24em] text-sky-700"><%= eyebrow %></p>
    <% end %>
    <h1 class="text-2xl font-semibold tracking-tight text-slate-950 sm:text-3xl"><%= title %></h1>
    <% if subtitle.present? %>
      <p class="max-w-2xl text-sm leading-6 text-slate-600 sm:text-base"><%= subtitle %></p>
    <% end %>
  </div>

  <% if local_assigns[:action_label].present? && local_assigns[:action_path].present? %>
    <%= link_to action_label, action_path, class: "inline-flex items-center justify-center rounded-full bg-sky-600 px-5 py-3 text-sm font-semibold text-white transition duration-200 hover:-translate-y-0.5 hover:bg-sky-500 hover:shadow-lg hover:shadow-sky-200" %>
  <% end %>
</div>
