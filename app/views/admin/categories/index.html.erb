<% content_for :admin_page_title, "Categories" %>

<%= render "admin/shared/page_header",
  eyebrow: "Catalog",
  title: "Категории",
  subtitle: "Управляйте структурой услуг и подавайте их в каталог без хаотичной верстки.",
  action_label: "Создать категорию",
  action_path: new_admin_category_path %>

<div class="overflow-hidden rounded-[1.75rem] border border-slate-200 bg-white shadow-[0_18px_40px_rgba(15,23,42,0.06)]">
  <div class="border-b border-slate-200 px-5 py-4 sm:px-6">
    <p class="text-sm text-slate-500"><%= resources_label %></p>
  </div>

  <% if resources.any? %>
    <div class="divide-y divide-slate-200">
      <% resources.each do |category| %>
        <div class="flex flex-col gap-4 px-5 py-5 transition hover:bg-slate-50 sm:flex-row sm:items-center sm:justify-between sm:px-6">
          <div class="space-y-1">
            <div class="flex items-center gap-3">
              <h2 class="text-lg font-semibold text-slate-950"><%= category.name %></h2>
              <span class="rounded-full border border-sky-200 bg-sky-50 px-3 py-1 text-xs font-semibold text-sky-700">Category</span>
            </div>
            <p class="max-w-2xl text-sm leading-6 text-slate-600"><%= category.description.presence || "Нет описания" %></p>
          </div>

          <div class="flex flex-wrap items-center gap-2">
            <%= link_to "Открыть", admin_category_path(category), class: "inline-flex items-center justify-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-slate-300 hover:bg-slate-50 hover:text-slate-950" %>
            <%= link_to "Редактировать", edit_admin_category_path(category), class: "inline-flex items-center justify-center rounded-full bg-sky-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-sky-500 hover:shadow-lg hover:shadow-sky-200" %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="px-5 py-16 sm:px-6">
      <%= render "shared/empty_state", title: "Категорий пока нет", description: "Создайте первую категорию, чтобы связать с ней услуги." %>
    </div>
  <% end %>
</div>
