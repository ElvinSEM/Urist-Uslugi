<% content_for :admin_page_title, @service.title %>

<%= render "admin/shared/page_header",
  eyebrow: "Catalog",
  title: @service.title,
  subtitle: @service.category_name,
  action_label: "Редактировать",
  action_path: edit_admin_service_path(@service) %>

<div class="grid gap-6 lg:grid-cols-[minmax(0,1.25fr)_minmax(280px,0.75fr)]">
  <section class="rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-[0_18px_40px_rgba(15,23,42,0.06)]">
    <div class="flex flex-wrap items-center gap-3">
      <%= service_category_badge(@service) %>
      <% if @service.published? %>
        <span class="rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700">Published</span>
      <% else %>
        <span class="rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-xs font-semibold text-slate-600">Draft</span>
      <% end %>
    </div>

    <div class="mt-6 max-w-none space-y-4 text-sm leading-7 text-slate-600">
      <%= simple_format(@service.description) %>
    </div>
  </section>

  <aside class="rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-[0_18px_40px_rgba(15,23,42,0.06)]">
    <h2 class="text-lg font-semibold text-slate-950">Детали</h2>
    <dl class="mt-4 space-y-4 text-sm">
      <div>
        <dt class="text-slate-500">Цена</dt>
        <dd class="mt-1 text-base font-semibold text-slate-950"><%= number_to_currency(@service.price, unit: "₽") %></dd>
      </div>
      <div>
        <dt class="text-slate-500">Позиция</dt>
        <dd class="mt-1 text-base font-semibold text-slate-950"><%= @service.position %></dd>
      </div>
    </dl>

    <div class="mt-6 flex flex-wrap gap-3">
      <%= link_to "К списку", admin_services_path, class: "inline-flex items-center justify-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-slate-300 hover:bg-slate-50 hover:text-slate-950" %>
      <%= link_to "Редактировать", edit_admin_service_path(@service), class: "inline-flex items-center justify-center rounded-full bg-sky-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-sky-500 hover:shadow-lg hover:shadow-sky-200" %>
    </div>
  </aside>
</div>
