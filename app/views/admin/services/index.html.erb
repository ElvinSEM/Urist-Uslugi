<div class="mb-6 flex items-center justify-between">
  <h1 class="text-3xl font-semibold">Services</h1>
  <%= link_to "New", new_admin_service_path, class: "rounded-lg bg-amber-500 px-4 py-2 text-black" %>
</div>
<% @services.each do |service| %>
  <div class="mb-3 rounded-xl bg-slate-900 p-4">
    <div class="flex items-center justify-between">
      <span><%= service.title %></span>
      <span><%= number_to_currency(service.price, unit: "₽") %></span>
    </div>
  </div>
<% end %>
