<% content_for :admin_page_title, "Services" %>

<%= render "admin/shared/page_header",
  eyebrow: "Catalog",
  title: "Услуги",
  subtitle: "Создавайте и редактируйте предложения, не теряя структуру и визуальную иерархию.",
  action_label: "Создать услугу",
  action_path: new_admin_service_path %>

<div class="overflow-hidden rounded-[1.75rem] border border-slate-200 bg-white shadow-[0_18px_40px_rgba(15,23,42,0.06)]">
  <div class="border-b border-slate-200 px-5 py-4 sm:px-6">
    <div class="grid gap-4 sm:grid-cols-3">
      <div>
        <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Всего</p>
        <p class="mt-1 text-2xl font-semibold text-slate-950"><%= resources.count %></p>
      </div>
      <div>
        <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Опубликовано</p>
        <p class="mt-1 text-2xl font-semibold text-slate-950"><%= resources.count(&:published) %></p>
      </div>
      <div>
        <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Категорий</p>
        <p class="mt-1 text-2xl font-semibold text-slate-950"><%= Category.count %></p>
      </div>
    </div>
  </div>

  <% if resources.any? %>
    <div class="divide-y divide-slate-200">
      <% resources.each do |service| %>
        <div class="flex flex-col gap-4 px-5 py-5 transition hover:bg-slate-50 sm:flex-row sm:items-center sm:justify-between sm:px-6">
          <div class="space-y-2">
            <div class="flex flex-wrap items-center gap-3">
              <h2 class="text-lg font-semibold text-slate-950"><%= service.title %></h2>
              <%= service_category_badge(service) %>
              <% if service.published? %>
                <span class="rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700">Published</span>
              <% else %>
                <span class="rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-xs font-semibold text-slate-600">Draft</span>
              <% end %>
            </div>
            <p class="max-w-2xl text-sm leading-6 text-slate-600"><%= truncate(service.description, length: 180) %></p>
            <p class="text-sm font-semibold text-slate-900"><%= number_to_currency(service.price, unit: "₽") %></p>
          </div>

          <div class="flex flex-wrap items-center gap-2">
            <%= link_to "Открыть", admin_service_path(service), class: "inline-flex items-center justify-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-slate-300 hover:bg-slate-50 hover:text-slate-950" %>
            <%= link_to "Редактировать", edit_admin_service_path(service), class: "inline-flex items-center justify-center rounded-full bg-sky-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-sky-500 hover:shadow-lg hover:shadow-sky-200" %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="px-5 py-16 sm:px-6">
      <%= render "shared/empty_state", title: "Услуг пока нет", description: "Добавьте первую услугу, чтобы каталог начал работать." %>
    </div>
  <% end %>
</div>
