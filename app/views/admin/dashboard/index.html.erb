<h1 class="mb-8 text-3xl font-semibold">Dashboard</h1>
<div class="mb-10 grid gap-4 md:grid-cols-5">
  <% @stats.each do |label, value| %>
    <div class="rounded-2xl bg-slate-900 p-5">
      <div class="text-xs uppercase tracking-wide text-slate-400"><%= label %></div>
      <div class="mt-2 text-3xl font-semibold"><%= value %></div>
    </div>
  <% end %>
</div>
<div class="rounded-2xl bg-slate-900 p-6">
  <h2 class="mb-4 text-xl font-medium">Последние заявки</h2>
  <% @recent_requests.each do |request| %>
    <div class="border-t border-slate-800 py-3 first:border-t-0 first:pt-0">
      #<%= request.id %> • <%= request.service.title %> • <%= request.status %>
    </div>
  <% end %>
</div>
