<% content_for :admin_page_title, "Dashboard" %>

<%= render "admin/shared/page_header",
  eyebrow: "Overview",
  title: "Dashboard",
  subtitle: "Ключевые метрики и последние заявки в одном экране.",
  action_label: "Создать услугу",
  action_path: new_admin_service_path %>

<div class="grid gap-4 md:grid-cols-2 xl:grid-cols-5">
  <% [
    ["Пользователи", @stats[:users]],
    ["Юристы", @stats[:lawyers]],
    ["Услуги", @stats[:services]],
    ["Заявки", @stats[:requests]],
    ["В ожидании", @stats[:pending_requests]]
  ].each do |label, value| %>
    <div class="rounded-[1.5rem] border border-slate-200 bg-white p-5 shadow-[0_18px_40px_rgba(15,23,42,0.06)]">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500"><%= label %></p>
      <p class="mt-3 text-3xl font-semibold tracking-tight text-slate-950"><%= value %></p>
    </div>
  <% end %>
</div>

<section class="mt-6 overflow-hidden rounded-[1.75rem] border border-slate-200 bg-white shadow-[0_18px_40px_rgba(15,23,42,0.06)]">
  <div class="border-b border-slate-200 px-5 py-4 sm:px-6">
    <h2 class="text-lg font-semibold text-slate-950">Последние заявки</h2>
  </div>

  <% if @recent_requests.any? %>
    <div class="divide-y divide-slate-200">
      <% @recent_requests.each do |request| %>
        <% request_summary = safe_join([
          content_tag(:div, class: "flex flex-wrap items-center justify-between gap-3") do
            safe_join([
              content_tag(:div, class: "flex items-center gap-3") do
                safe_join([
                  content_tag(:span, "##{request.id}", class: "rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-xs font-semibold text-slate-600"),
                  content_tag(:span, request.service.title, class: "text-sm font-semibold text-slate-950")
                ])
              end,
              content_tag(:span, service_request_status_label(request.status), class: "rounded-full border border-sky-200 bg-sky-50 px-3 py-1 text-xs font-semibold text-sky-700")
            ])
          end,
          content_tag(:p, "#{request.client.full_name} · #{request.created_at.strftime('%d.%m.%Y %H:%M')}", class: "text-sm text-slate-500")
        ]) %>
        <%= link_to request_summary, admin_service_request_path(request), class: "flex flex-col gap-2 px-5 py-5 transition hover:bg-slate-50 sm:px-6" %>
      <% end %>
    </div>
  <% else %>
    <div class="px-5 py-16 sm:px-6">
      <%= render "shared/empty_state", title: "Заявок пока нет", description: "После первых обращений они появятся здесь." %>
    </div>
  <% end %>
</section>
