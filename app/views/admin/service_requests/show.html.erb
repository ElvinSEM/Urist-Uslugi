<% content_for :admin_page_title, "Request ##{@service_request.id}" %>

<%= render "admin/shared/page_header",
  eyebrow: "Operations",
  title: "Заявка ##{@service_request.id}",
  subtitle: @service_request.service.title,
  action_path: admin_service_requests_path,
  action_label: "К списку" %>

<div class="grid gap-6 lg:grid-cols-[minmax(0,1.2fr)_minmax(320px,0.8fr)]">
  <section class="rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-[0_18px_40px_rgba(15,23,42,0.06)]">
    <div class="flex flex-wrap items-center gap-3">
      <span class="rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-xs font-semibold text-slate-600"><%= service_request_status_label(@service_request.status) %></span>
      <%= service_category_badge(@service_request.service) %>
    </div>

    <dl class="mt-6 grid gap-4 sm:grid-cols-2">
      <div>
        <dt class="text-sm text-slate-500">Клиент</dt>
        <dd class="mt-1 text-base font-semibold text-slate-950"><%= @service_request.client.full_name %></dd>
      </div>
      <div>
        <dt class="text-sm text-slate-500">Email</dt>
        <dd class="mt-1 text-base font-semibold text-slate-950"><%= @service_request.email %></dd>
      </div>
      <div>
        <dt class="text-sm text-slate-500">Телефон</dt>
        <dd class="mt-1 text-base font-semibold text-slate-950"><%= @service_request.phone %></dd>
      </div>
      <div>
        <dt class="text-sm text-slate-500">Юрист</dt>
        <dd class="mt-1 text-base font-semibold text-slate-950"><%= @service_request.lawyer&.full_name || "Не назначен" %></dd>
      </div>
    </dl>

    <div class="mt-6 rounded-3xl border border-slate-200 bg-slate-50 p-5">
      <h2 class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500">Описание</h2>
      <p class="mt-3 whitespace-pre-wrap text-sm leading-7 text-slate-600"><%= @service_request.description %></p>
    </div>
  </section>

  <aside class="rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-[0_18px_40px_rgba(15,23,42,0.06)]">
    <h2 class="text-lg font-semibold text-slate-950">Статус</h2>
    <div class="mt-4 flex flex-col gap-3">
      <% ServiceRequest.statuses.keys.each do |status| %>
        <%= button_to service_request_status_label(status), transition_admin_service_request_path(@service_request, status: status), method: :patch, class: "inline-flex items-center justify-center rounded-full px-4 py-3 text-sm font-semibold transition #{status == @service_request.status ? 'bg-sky-600 text-white shadow-lg shadow-sky-200' : 'border border-slate-200 bg-white text-slate-700 hover:border-slate-300 hover:bg-slate-50 hover:text-slate-950'}" %>
      <% end %>
    </div>

    <div class="mt-6 flex flex-wrap gap-3">
      <%= link_to "К списку", admin_service_requests_path, class: "inline-flex items-center justify-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-slate-300 hover:bg-slate-50 hover:text-slate-950" %>
    </div>
  </aside>
</div>
