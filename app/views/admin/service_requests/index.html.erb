<% content_for :admin_page_title, "Requests" %>

<%= render "admin/shared/page_header",
  eyebrow: "Operations",
  title: "Заявки",
  subtitle: "Следите за статусами, назначением юристов и обработкой обращений.",
  action_path: admin_service_requests_path,
  action_label: "Обновить список" %>

<div class="overflow-hidden rounded-[1.75rem] border border-slate-200 bg-white shadow-[0_18px_40px_rgba(15,23,42,0.06)]">
  <div class="border-b border-slate-200 px-5 py-4 sm:px-6">
    <p class="text-sm text-slate-500"><%= @service_requests.count %> записей</p>
  </div>

  <% if @service_requests.any? %>
    <div class="divide-y divide-slate-200">
      <% @service_requests.each do |request| %>
        <div class="flex flex-col gap-4 px-5 py-5 transition hover:bg-slate-50 sm:flex-row sm:items-center sm:justify-between sm:px-6">
          <div class="space-y-1">
            <div class="flex flex-wrap items-center gap-3">
              <span class="rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-xs font-semibold text-slate-600">#<%= request.id %></span>
              <h2 class="text-lg font-semibold text-slate-950"><%= request.service.title %></h2>
              <span class="rounded-full border border-sky-200 bg-sky-50 px-3 py-1 text-xs font-semibold text-sky-700"><%= service_request_status_label(request.status) %></span>
            </div>
            <p class="text-sm leading-6 text-slate-600"><%= request.client.full_name %> · <%= request.client.email %></p>
          </div>

          <div class="flex flex-wrap items-center gap-2">
            <%= link_to "Открыть", admin_service_request_path(request), class: "inline-flex items-center justify-center rounded-full bg-sky-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-sky-500 hover:shadow-lg hover:shadow-sky-200" %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="px-5 py-16 sm:px-6">
      <%= render "shared/empty_state", title: "Заявок пока нет", description: "После первых обращений они появятся здесь." %>
    </div>
  <% end %>
</div>
