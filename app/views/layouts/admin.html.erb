<!DOCTYPE html>
<html lang="ru">
  <head>
    <title><%= content_for(:admin_page_title).presence || "Admin" %> | Услуги Юриста</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
    <div class="flex min-h-screen flex-col lg:flex-row">
      <aside class="border-b border-slate-200 bg-white/95 px-5 py-4 backdrop-blur lg:sticky lg:top-0 lg:h-screen lg:w-72 lg:border-b-0 lg:border-r lg:px-6 lg:py-6">
        <div class="mb-6 flex items-center justify-between lg:block">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-sky-700">Admin Panel</p>
            <h1 class="mt-2 text-2xl font-semibold text-slate-950">Услуги Юриста</h1>
          </div>
          <div class="rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-xs font-semibold text-slate-600 lg:mt-4">
            Rails 8.1
          </div>
        </div>

        <nav class="grid gap-2 text-sm">
          <%= link_to "Dashboard", admin_root_path, class: admin_nav_link_class(admin_root_path, exact: true) %>
          <%= link_to "Users", admin_users_path, class: admin_nav_link_class("/admin/users") %>
          <%= link_to "Categories", admin_categories_path, class: admin_nav_link_class("/admin/categories") %>
          <%= link_to "Services", admin_services_path, class: admin_nav_link_class("/admin/services") %>
          <%= link_to "Requests", admin_service_requests_path, class: admin_nav_link_class("/admin/service_requests") %>
        </nav>

        <div class="mt-6 border-t border-slate-200 pt-6">
          <%= button_to destroy_user_session_path, method: :delete, form: { class: "w-full" }, class: "inline-flex w-full items-center justify-center rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-slate-700 transition duration-200 hover:border-rose-200 hover:bg-rose-50 hover:text-rose-700" do %>
            Выйти
          <% end %>
        </div>
      </aside>

      <div class="flex min-h-screen flex-1 flex-col bg-[radial-gradient(circle_at_top_right,_rgba(14,165,233,0.08),_transparent_28%),linear-gradient(180deg,_#f8fafc_0%,_#f8fafc_100%)]">
        <header class="border-b border-slate-200 bg-white/80 px-4 py-4 backdrop-blur sm:px-6 lg:px-8">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <p class="text-sm text-slate-500">Control center</p>
              <h2 class="text-lg font-semibold text-slate-950"><%= content_for(:admin_page_title).presence || "Dashboard" %></h2>
            </div>
            <div class="flex items-center gap-3 text-sm text-slate-500">
              <span class="hidden rounded-full border border-slate-200 bg-slate-50 px-3 py-1 sm:inline-flex">Turbo on</span>
              <span class="hidden rounded-full border border-slate-200 bg-slate-50 px-3 py-1 sm:inline-flex">Stimulus on</span>
              <%= link_to "На сайт", root_path, class: "inline-flex items-center justify-center rounded-full border border-slate-200 bg-white px-3 py-1.5 text-sm font-semibold text-slate-700 transition hover:border-sky-200 hover:bg-sky-50 hover:text-sky-700" %>
              <%= button_to destroy_user_session_path, method: :delete, form: { class: "inline-flex" }, class: "inline-flex items-center justify-center rounded-full border border-slate-200 bg-white px-3 py-1.5 text-sm font-semibold text-slate-700 transition hover:border-rose-200 hover:bg-rose-50 hover:text-rose-700" do %>
                Выйти
              <% end %>
            </div>
          </div>
        </header>

        <main class="flex-1 px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
          <%= render "shared/flash" %>
          <%= yield %>
        </main>
      </div>
    </div>
  </body>
</html>
