<section class="bg-slate-50">
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <div class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-[0_20px_60px_rgba(15,23,42,0.08)]">
      <div class="relative isolate overflow-hidden bg-[radial-gradient(circle_at_top_right,_rgba(14,165,233,0.16),_transparent_28%),radial-gradient(circle_at_bottom_left,_rgba(59,130,246,0.12),_transparent_24%),linear-gradient(180deg,_#ffffff_0%,_#f8fafc_100%)] px-6 py-10 sm:px-8 lg:px-10 lg:py-12">
        <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-sky-300/70 to-transparent"></div>

        <div class="grid gap-8 lg:grid-cols-[minmax(0,1.25fr)_minmax(280px,0.75fr)] lg:items-end">
          <div class="max-w-3xl space-y-5">
            <span class="inline-flex items-center rounded-full border border-sky-200 bg-sky-50 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.24em] text-sky-700">
              Legal Blog
            </span>

            <div class="space-y-4">
              <h1 class="text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl lg:text-6xl">
                Практические статьи и
                <span class="text-sky-700">юридические разборы</span>
              </h1>
              <p class="max-w-2xl text-base leading-8 text-slate-600 sm:text-lg">
                Подборка коротких и полезных материалов о праве, договорной работе и сопровождении клиентов.
                Открывайте статьи, чтобы читать полные тексты.
              </p>
            </div>
          </div>

          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
            <div class="rounded-3xl border border-slate-200 bg-white/90 p-5 shadow-sm">
              <dt class="text-xs font-medium uppercase tracking-[0.2em] text-slate-500">Постов</dt>
              <dd class="mt-2 text-3xl font-semibold text-slate-950"><%= @posts.count %></dd>
            </div>
            <div class="rounded-3xl border border-sky-200 bg-sky-50/80 p-5 shadow-sm">
              <dt class="text-xs font-medium uppercase tracking-[0.2em] text-sky-700">Публикации</dt>
              <dd class="mt-2 text-3xl font-semibold text-sky-700">Live</dd>
            </div>
          </div>
        </div>
      </div>

      <div class="px-6 pb-8 pt-2 sm:px-8 lg:px-10 lg:pt-4">
        <% if @posts.any? %>
          <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
            <% @posts.each do |post| %>
              <article class="group flex h-full flex-col overflow-hidden rounded-[1.75rem] border border-slate-200 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-[0_20px_50px_rgba(15,23,42,0.12)]">
                <div class="aspect-[16/10] overflow-hidden bg-slate-100">
                  <%= image_tag "blog/when-to-update-your-legal-documents.svg" %>
                </div>

                <div class="flex flex-1 flex-col p-5 sm:p-6">
                  <h2 class="text-xl font-semibold tracking-tight text-slate-950"><%= post.title %></h2>
                  <p class="mt-3 text-sm leading-7 text-slate-600">
                    <%= truncate(strip_tags(post.content), length: 140) %>
                  </p>

                  <div class="mt-6">
                    <%= link_to "Read more →", post_path(post), class: "inline-flex items-center gap-2 text-sm font-semibold text-sky-700 transition hover:text-sky-600" %>
                  </div>
                </div>
              </article>
            <% end %>
          </div>
        <% else %>
          <div class="rounded-[1.75rem] border border-dashed border-slate-300 bg-slate-50 px-6 py-16 text-center">
            <h2 class="text-xl font-semibold text-slate-950">Пока нет опубликованных статей</h2>
            <p class="mt-2 text-sm leading-7 text-slate-500">Добавьте записи в `db/seeds.rb` или создайте новые посты в базе данных.</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>
