<section id="services" class="bg-slate-50 py-16 sm:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-8 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div class="max-w-3xl">
        <span class="inline-flex items-center rounded-full border border-sky-200 bg-sky-50 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.24em] text-sky-700">
          Services
        </span>
        <h2 class="mt-4 text-3xl font-semibold tracking-[-0.04em] text-slate-950 sm:text-4xl lg:text-5xl">
          Список услуг как витрина решения
        </h2>
        <p class="mt-4 max-w-2xl text-base leading-8 text-slate-600">
          Карточки показывают суть услуги, базовую стоимость и быстрый путь к просмотру или заявке.
        </p>
      </div>

      <%= link_to "Все услуги", services_path, class: "inline-flex items-center justify-center rounded-full border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-700 transition hover:border-slate-300 hover:text-slate-950 hover:shadow-sm" %>
    </div>

    <% if services.any? %>
      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        <% services.each do |service| %>
          <article class="group flex h-full flex-col rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-[0_14px_32px_rgba(15,23,42,0.05)] transition hover:-translate-y-1 hover:shadow-[0_20px_48px_rgba(15,23,42,0.1)]">
            <div class="flex items-start justify-between gap-4">
              <span class="inline-flex rounded-full border border-sky-200 bg-sky-50 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.2em] text-sky-700">
                <%= service.category_name %>
              </span>
              <span class="text-sm font-semibold text-slate-500"><%= number_to_currency(service.price, unit: "₽") %></span>
            </div>

            <h3 class="mt-5 text-2xl font-semibold tracking-[-0.04em] text-slate-950">
              <%= service.title %>
            </h3>

            <p class="mt-3 text-sm leading-7 text-slate-600">
              <%= truncate(service.description, length: 140) %>
            </p>

            <div class="mt-6 flex flex-wrap gap-3">
              <%= link_to "Подробнее", service_path(service), class: "inline-flex items-center justify-center rounded-full border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:border-slate-300 hover:bg-white hover:text-slate-950" %>
              <%= link_to "Заявка", new_service_request_path(service_id: service.id), class: "inline-flex items-center justify-center rounded-full bg-sky-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-sky-500" %>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="rounded-[1.75rem] border border-dashed border-slate-300 bg-white px-6 py-16 text-center">
        <h3 class="text-xl font-semibold text-slate-950">Услуги пока не опубликованы</h3>
        <p class="mt-2 text-sm leading-7 text-slate-500">После добавления записей они появятся в каталоге и на главной.</p>
      </div>
    <% end %>
  </div>
</section>
