<header class="navbar">
  <div class="navbar__bar">
    <div class="navbar__shell">
      <%= link_to raw(
        '<span class="navbar__mark" aria-hidden="true">ПЭ</span>' \
        '<span class="navbar__brand-text">' \
        '<span class="navbar__brand-name">Правовой<br>элемент</span>' \
        '</span>'
      ), root_path, class: "navbar__brand" %>

      <div class="navbar__claim navbar__claim--desktop">
        Центр юридической помощи
      </div>

      <nav class="navbar__nav" aria-label="Основная навигация">
        <%= link_to "Услуги", services_path, class: "navbar__link" %>
        <%= link_to "Преимущества", root_path(anchor: "why-us"), class: "navbar__link" %>
        <%= link_to "Блог", posts_path, class: "navbar__link" %>
        <%= link_to "Контакты", root_path(anchor: "cta"), class: "navbar__link" %>
        <%= link_to "Консультация", new_service_request_path, class: "navbar__link" %>
      </nav>

      <div class="navbar__actions">
        <div class="navbar__contacts">
          <div class="navbar__phone-row">
            <%= link_to "+38 063 425 90 30", "tel:+380634259030", class: "navbar__phone-link" %>
            <span class="navbar__phone-part">30</span>
            <%= link_to raw(
              '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M21.8 4.6 18.6 19c-.2 1-.8 1.2-1.6.8l-4.4-3.2-2.1 2c-.2.2-.4.4-.8.4l.3-4.6L18.8 6c.4-.3-.1-.5-.5-.2L7.5 12.2l-4.5-1.4c-1-.3-1-1 .2-1.5L20.3 3c.9-.3 1.6.2 1.5 1.6Z" fill="currentColor"/></svg>'
            ), "https://t.me/", class: "navbar__messenger", aria: { label: "Telegram" } %>
          </div>
          <%= link_to "Перезвоните мне", new_service_request_path, class: "navbar__callback" %>
        </div>

        <%= link_to "Записаться на консультацию", new_service_request_path, class: "navbar__cta" %>

        <div class="navbar__lang">
          <button type="button" class="navbar__lang-button" aria-label="Russian language selector">
            <span>Рус</span>
            <span aria-hidden="true">▼</span>
          </button>
        </div>
      </div>

      <details class="navbar__mobile">
        <summary class="navbar__mobile-toggle">Меню</summary>

        <div class="navbar__mobile-panel">
          <nav class="navbar__mobile-nav" aria-label="Мобильная навигация">
            <%= link_to "Услуги", services_path, class: "navbar__mobile-link" %>
            <%= link_to "Преимущества", root_path(anchor: "why-us"), class: "navbar__mobile-link" %>
            <%= link_to "Блог", posts_path, class: "navbar__mobile-link" %>
            <%= link_to "Контакты", root_path(anchor: "cta"), class: "navbar__mobile-link" %>
            <%= link_to "Консультация", new_service_request_path, class: "navbar__mobile-link" %>
          </nav>

          <div class="navbar__mobile-meta">
            <div class="navbar__mobile-phone">
              <%= link_to "+38 063 425 90 30", "tel:+380634259030", class: "navbar__phone-link" %>
            </div>
            <%= link_to "Перезвоните мне", new_service_request_path, class: "navbar__callback navbar__callback--mobile" %>
            <%= link_to "Записаться на консультацию", new_service_request_path, class: "navbar__cta navbar__cta--mobile" %>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>
