<article class="group relative flex h-full flex-col overflow-hidden rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-sky-200 hover:shadow-[0_24px_60px_rgba(14,165,233,0.12)]">
  <% cache service do %>
    <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-sky-500 via-cyan-400 to-sky-300 opacity-0 transition duration-300 group-hover:opacity-100"></div>

    <div class="flex items-start justify-between gap-4">
      <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-slate-50 text-sky-700 ring-1 ring-slate-200 transition duration-300 group-hover:bg-sky-600 group-hover:text-white group-hover:ring-sky-200">
        <%= service_category_icon(service_category_variant(service.category_name)[:icon], "group-hover:text-white") %>
      </div>

      <%= service_category_badge(service) %>
    </div>

    <div class="mt-5 flex-1 space-y-3">
      <h3 class="text-xl font-semibold tracking-tight text-slate-950 transition duration-300 group-hover:text-sky-700">
        <%= link_to service.title, service_path(service), class: "outline-none focus-visible:rounded-lg focus-visible:ring-4 focus-visible:ring-sky-100" %>
      </h3>

      <p class="line-clamp-3 text-sm leading-7 text-slate-600">
        <%= truncate(service.description, length: 150) %>
      </p>
    </div>

    <div class="mt-6 flex items-end justify-between gap-4 border-t border-slate-100 pt-5">
      <div>
        <p class="text-xs font-medium uppercase tracking-[0.2em] text-slate-400">Стоимость</p>
        <strong class="mt-1 block text-2xl font-semibold text-slate-950">
          <%= number_to_currency(service.price, unit: "₽") %>
        </strong>
      </div>

      <div class="flex flex-col gap-2 sm:flex-row">
        <%= link_to "Подробнее", service_path(service), class: "inline-flex items-center justify-center rounded-full border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition duration-300 hover:-translate-y-0.5 hover:border-slate-300 hover:text-slate-950 hover:shadow-md" %>
        <%= link_to "Заявка", new_service_request_path(service_id: service.id), class: "inline-flex items-center justify-center rounded-full bg-sky-600 px-4 py-2.5 text-sm font-semibold text-white transition duration-300 hover:-translate-y-0.5 hover:bg-sky-500 hover:shadow-lg hover:shadow-sky-200" %>
      </div>
    </div>
  <% end %>
</article>
