<turbo-frame id="flash">
  <% flash.each do |type, message| %>
    <% type_class =
      case type.to_sym
      when :notice then "border-emerald-200 bg-emerald-50 text-emerald-900"
      when :alert then "border-rose-200 bg-rose-50 text-rose-900"
      else "border-slate-200 bg-white text-slate-900"
      end %>
    <div class="mb-4 flex items-start justify-between gap-4 rounded-2xl border px-4 py-3 shadow-sm <%= type_class %>" data-controller="flash" data-action="animationend->flash#remove">
      <div>
        <strong class="block text-sm font-semibold uppercase tracking-[0.18em]"><%= type.to_s.humanize %></strong>
        <p class="mt-1 text-sm leading-6"><%= message %></p>
      </div>
      <button type="button" class="rounded-full px-2 text-lg leading-none text-current/60 transition hover:bg-black/5 hover:text-current" data-action="click->flash#remove" aria-label="Закрыть">×</button>
    </div>
  <% end %>
</turbo-frame>
