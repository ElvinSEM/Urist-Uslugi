<section id="cta" class="bg-white py-16 sm:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="overflow-hidden rounded-[2rem] border border-slate-200 bg-[linear-gradient(135deg,#2b78d4_0%,#377fd8_34%,#1f3f70_72%,#07111f_100%)] text-white shadow-[0_22px_56px_rgba(15,23,42,0.22)]">
      <div class="grid gap-8 px-6 py-10 sm:px-8 lg:grid-cols-[minmax(0,1.05fr)_minmax(330px,0.95fr)] lg:px-10 lg:py-12">
        <div class="max-w-3xl">
          <span class="inline-flex items-center rounded-full border border-white/15 bg-white/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.24em] text-white/90">
            Final step
          </span>
          <h2 class="mt-4 text-3xl font-semibold tracking-[-0.05em] text-white sm:text-4xl lg:text-5xl">
            Оставьте заявку и получите ясный следующий шаг
          </h2>
          <p class="mt-4 max-w-2xl text-base leading-8 text-slate-200">
            Страница заканчивается там, где клиенту проще всего принять решение: с понятной кнопкой консультации и быстрым контактом.
          </p>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <%= link_to "Записаться на консультацию", new_service_request_path, class: "inline-flex items-center justify-center rounded-full bg-white px-6 py-3.5 text-sm font-semibold text-slate-950 transition hover:-translate-y-0.5 hover:bg-slate-100" %>
            <%= link_to "Посмотреть услуги", services_path, class: "inline-flex items-center justify-center rounded-full border border-white/20 bg-white/10 px-6 py-3.5 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:bg-white/15" %>
          </div>
        </div>

        <div class="grid gap-4 self-center">
          <div class="rounded-[1.75rem] border border-white/10 bg-white/10 p-6">
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-100/80">Contact</p>
            <p class="mt-3 text-2xl font-semibold tracking-[-0.04em] text-white">Связь без длинных форм</p>
            <p class="mt-3 text-sm leading-7 text-slate-200">Один понятный маршрут: выбрать, отправить, получить ответ.</p>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="rounded-[1.5rem] border border-white/10 bg-slate-950/30 p-5">
              <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-100/80">Phone</p>
              <p class="mt-2 text-lg font-semibold tracking-[-0.03em] text-white">+38 063 425 90 30</p>
            </div>
            <div class="rounded-[1.5rem] border border-white/10 bg-slate-950/30 p-5">
              <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-100/80">Mode</p>
              <p class="mt-2 text-lg font-semibold tracking-[-0.03em] text-white">Online / Fast</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
