<section id="hero" class="relative overflow-hidden bg-[linear-gradient(135deg,#2a79d4_0%,#4f8fe5_34%,#102746_72%,#07111f_100%)] text-white">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,_rgba(255,255,255,0.16),_transparent_26%),radial-gradient(circle_at_right,_rgba(255,255,255,0.08),_transparent_18%)]"></div>
  <div class="absolute inset-y-0 right-0 w-[28rem] bg-[linear-gradient(180deg,rgba(255,255,255,0.04),rgba(255,255,255,0.01))] blur-3xl"></div>

  <div class="relative mx-auto max-w-7xl px-4 pt-8 sm:px-6 lg:px-8 lg:pt-12">
    <div class="overflow-hidden rounded-[2rem] border border-white/10 bg-white/5 shadow-[0_24px_80px_rgba(2,6,23,0.26)] backdrop-blur-md">
      <div class="grid gap-10 px-6 py-10 sm:px-8 lg:grid-cols-[minmax(0,1.15fr)_minmax(330px,0.85fr)] lg:px-10 lg:py-14">
        <div class="flex flex-col justify-between gap-8">
          <div class="max-w-3xl space-y-6">
            <div class="flex flex-wrap items-center gap-3">
              <span class="inline-flex items-center rounded-full border border-white/15 bg-white/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.24em] text-white/90">
                Premium legal SaaS
              </span>
              <span class="inline-flex items-center rounded-full border border-sky-200/30 bg-sky-300/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.24em] text-sky-100">
                <%= services_count %> services available
              </span>
            </div>

            <div class="space-y-4">
              <h1 class="max-w-4xl text-5xl font-semibold tracking-[-0.05em] text-white sm:text-6xl lg:text-7xl">
                Юридический сервис, где
                <span class="text-sky-200">следующий шаг</span>
                очевиден
              </h1>
              <p class="max-w-2xl text-base leading-8 text-slate-200 sm:text-lg">
                Помогаем выбрать услугу, быстро оформить заявку и пройти путь без лишней бюрократии.
                Сервис построен как современный B2B-интерфейс: ясно, спокойно и по делу.
              </p>
            </div>

            <div class="flex flex-col gap-3 sm:flex-row">
              <%= link_to "Посмотреть услуги", services_path, class: "inline-flex items-center justify-center rounded-full bg-white px-6 py-3.5 text-sm font-semibold text-slate-950 shadow-[0_16px_32px_rgba(2,6,23,0.18)] transition hover:-translate-y-0.5 hover:bg-slate-100" %>
              <%= link_to "Оставить заявку", new_service_request_path, class: "inline-flex items-center justify-center rounded-full border border-white/20 bg-white/10 px-6 py-3.5 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:bg-white/15" %>
            </div>
          </div>

          <dl class="grid gap-3 sm:grid-cols-3">
            <div class="rounded-3xl border border-white/10 bg-white/10 px-5 py-4">
              <dt class="text-xs font-semibold uppercase tracking-[0.22em] text-sky-100/80">Catalog</dt>
              <dd class="mt-2 text-2xl font-semibold tracking-[-0.04em] text-white"><%= services_count %>+</dd>
            </div>
            <div class="rounded-3xl border border-white/10 bg-white/10 px-5 py-4">
              <dt class="text-xs font-semibold uppercase tracking-[0.22em] text-sky-100/80">Response</dt>
              <dd class="mt-2 text-2xl font-semibold tracking-[-0.04em] text-white">Fast</dd>
            </div>
            <div class="rounded-3xl border border-white/10 bg-white/10 px-5 py-4">
              <dt class="text-xs font-semibold uppercase tracking-[0.22em] text-sky-100/80">Format</dt>
              <dd class="mt-2 text-2xl font-semibold tracking-[-0.04em] text-white">Online</dd>
            </div>
          </dl>
        </div>

        <aside class="grid gap-4 self-center">
          <div class="rounded-[1.75rem] border border-white/10 bg-slate-950/70 p-6 shadow-[0_18px_50px_rgba(2,6,23,0.28)]">
            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-sky-200/85">Consultation</p>
            <h2 class="mt-3 text-2xl font-semibold tracking-[-0.04em] text-white">
              Запустите заявку за один короткий шаг
            </h2>
            <p class="mt-3 text-sm leading-7 text-slate-300">
              Четкая карточка услуги, понятная стоимость и быстрый переход к консультации.
            </p>

            <div class="mt-6 grid gap-3">
              <div class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3">
                <div class="text-xs uppercase tracking-[0.2em] text-sky-200/80">Step 1</div>
                <div class="mt-1 text-sm font-medium text-white">Выберите услугу</div>
              </div>
              <div class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3">
                <div class="text-xs uppercase tracking-[0.2em] text-sky-200/80">Step 2</div>
                <div class="mt-1 text-sm font-medium text-white">Оставьте заявку</div>
              </div>
              <div class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3">
                <div class="text-xs uppercase tracking-[0.2em] text-sky-200/80">Step 3</div>
                <div class="mt-1 text-sm font-medium text-white">Получите обратную связь</div>
              </div>
            </div>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="rounded-[1.75rem] border border-white/10 bg-white/10 p-5">
              <p class="text-xs font-semibold uppercase tracking-[0.22em] text-sky-100/80">Focus</p>
              <p class="mt-2 text-lg font-semibold tracking-[-0.03em] text-white">Договоры и сопровождение</p>
            </div>
            <div class="rounded-[1.75rem] border border-white/10 bg-white/10 p-5">
              <p class="text-xs font-semibold uppercase tracking-[0.22em] text-sky-100/80">Tone</p>
              <p class="mt-2 text-lg font-semibold tracking-[-0.03em] text-white">Просто и понятно</p>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </div>
</section>
